# Exclude directories that can cause zip corruption
agents/genagents/.git/
agents/genagents/**/.git/
**/.git/
**/.vscode/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/node_modules/

# Exclude test and development files
**/tests/
**/test_*.py
**/*_test.py

# Exclude large log files
logs/
*.log

# Exclude environment files
.env
.env.*
**/.venv/
**/venv/

# Exclude temporary files
**/*.tmp
**/tmp_*.txt
**/.DS_Store
**/Thumbs.db
