# CommonGround puzzle — environment configuration.
# Copy to `.env` and fill in. AI modes (human-ai, ai-ai) need an AI backend.

# --- AI backend -------------------------------------------------------------
# Option A: Azure OpenAI with Entra ID (run `az login` first) — also for MSR TRAPI
#   set OPENAI_ENDPOINT + OPENAI_SCOPE + OPENAI_GPT4_DEPLOYMENT + OPENAI_API_VERSION
# Option B: Azure OpenAI with an API key
#   set OPENAI_ENDPOINT + OPENAI_API_KEY + OPENAI_GPT4_DEPLOYMENT + OPENAI_API_VERSION
# Option C: Standard OpenAI (api.openai.com)
#   set OPENAI_API_KEY only, and OPENAI_GPT4_DEPLOYMENT to a model name (e.g. gpt-4o)
# Note: if OPENAI_SCOPE is set, Entra ID is used and OPENAI_API_KEY is ignored.

OPENAI_ENDPOINT=
OPENAI_API_KEY=
# For Entra ID auth, set the scope, e.g. https://cognitiveservices.azure.com/.default
OPENAI_SCOPE=
OPENAI_GPT4_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-06-01

# --- Web app (optional) -----------------------------------------------------
# Port for the web app (default 5000). PORT is also read by run_server.
PORT=5000
# Directory for logs (default: <app>/logs).
# LOG_DIR=logs
# Set a stable random session-signing key for self-hosted runs.
# If omitted, restarting the app invalidates browser login sessions.
# FLASK_SECRET_KEY=
# Defaults for direct WSGI/Gunicorn launches; CLI launch options take precedence.
# AUTO_START_MODE=worker
# SHARED_VIEW_ENABLED=true
# RUN_STUDY_MODE=false
# Socket.IO defaults to same-origin; list explicit origins only if needed.
# SOCKETIO_ALLOWED_ORIGINS=http://localhost:5000

# --- Study mode (optional) --------------------------------------------------
STUDY_ID=123
# FORMS_QUESTIONNAIRE_URL=
# USER_CREDENTIALS_FILE=utils/user_credentials.json
