# Azure deployment ignore file for VS Code
# These files will be excluded when deploying via VS Code Azure extension

# Exclude large log files and temporary files
logs/
*.log
tmp_*.txt
tmp_*.png
**/*.tmp

# Exclude Python cache and compiled files
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/

# Exclude virtual environments
.venv/
venv/
env/

# Exclude environment and config files
.env
.env.*

# Exclude IDE files
.vscode/
.idea/
**/.DS_Store
**/Thumbs.db

# Exclude test files
test_*.py
*_test.py
tests/

# Exclude documentation files
*.md
INSTALL.md
README*.md
QUICK_START.md
LOGGING_README.md
UBUNTU_DEPLOYMENT.md
LLM_*.md
TEST_*.md

# Exclude development/deployment scripts
deploy_azure.ps1
run_experiments.py
run_web_app.ps1
run_web_app.sh
demo.py
test_*.py
generate_users.py
tile_pattern_creator.py

# Exclude database files (will be created on Azure)
database/

# Exclude VS Code ignore files themselves
.vscodeignore
.zipignore
.gitignore

# Exclude service files
*.service
